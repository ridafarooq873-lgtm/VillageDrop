# Server
PORT=5000

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/villagedrop

# Auth
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d
ADMIN_BOOTSTRAP_KEY=replace-with-a-separate-random-secret-of-at-least-32-characters

# Frontend origin allowed to talk to the API / sockets
CLIENT_URL=http://localhost:5173
