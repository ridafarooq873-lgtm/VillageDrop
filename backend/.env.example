# Server
PORT=5000

# MongoDB connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/villagedrop?retryWrites=true&w=majority

# Auth
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d
ADMIN_BOOTSTRAP_KEY=replace-with-a-separate-random-secret-of-at-least-32-characters

# Frontend origin allowed to talk to the API / sockets
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173
